{
  "name": "ytranscript-api",
  "version": "0.5.0",
  "description": "Reliable YouTube transcript and video metadata API client — your servers never get IP-banned, no proxy management, Whisper fallback for captionless videos.",
  "keywords": [
    "youtube",
    "transcript",
    "youtube transcript api",
    "youtube video metadata",
    "captions",
    "subtitles",
    "whisper",
    "speech-to-text",
    "transcription"
  ],
  "homepage": "https://ytranscript.com/developers",
  "bugs": {
    "url": "https://github.com/nnnoel/ytranscript-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnnoel/ytranscript-js.git"
  },
  "license": "MIT",
  "author": "yTranscript <support@ytranscript.com> (https://ytranscript.com)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "preversion": "node scripts/version.mjs changelog",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
